# Địa chỉ URL máy chủ API SmartBus Backend
# Với Web / iOS Simulator: http://localhost:5000
# Với Android Emulator: http://10.0.2.2:5000
# Với thiết bị thật cùng mạng Wi-Fi: http://<LAN-IP-MAY-TINH>:5000 (ví dụ http://192.168.1.100:5000)
# Với HTTPS Tunnel (ngrok/Cloudflare Tunnel): https://<your-subdomain>.ngrok-free.app
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000
